      "id": "render_title_txt",
      "x": 1830, "y": 425, "width": 510, "height": 30,
      "text": "return ( … JSX … )",
      "originalText": "return ( … JSX … )",
      "fontSize": 18, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#064e3b", "backgroundColor": "transparent",
