    {
      "type": "text", "id": "layer2_txt",
      "x": 715, "y": 322, "width": 290, "height": 110,
      "text": "ScatterplotLayer  ('city-bubbles')\n  • position = [d.lon, d.lat]\n  • fillColor = bubbleColor(metric value, bMin, bMax, invert)\n  • no beforeId  → rendered on top (above water)\n  • updateTriggers: getFillColor ↔ [bubbleMetric, bMin, bMax]\n  • onClick → setSelectedCity ; onHover → setHoverInfo",
      "originalText": "ScatterplotLayer  ('city-bubbles')\n  • position = [d.lon, d.lat]\n  • fillColor = bubbleColor(metric value, bMin, bMax, invert)\n  • no beforeId  → rendered on top (above water)\n  • updateTriggers: getFillColor ↔ [bubbleMetric, bMin, bMax]\n  • onClick → setSelectedCity ; onHover → setHoverInfo",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
