    {
      "type": "text",
      "id": "eff4_note",
      "x": 1450,
      "y": 1075,
      "width": 340,
      "height": 75,
      "text": "Deps: [climateData, variable, cities, bubbleMetric].\nBuilds heatmap cells from grid → SolidPolygonLayer\n(calls getColor) + ScatterplotLayer for cities (calls\nbubbleColor). Sets overlay.setProps({ layers }).\nHover handlers populate hoverInfo state.",
      "originalText": "Deps: [climateData, variable, cities, bubbleMetric].\nBuilds heatmap cells from grid → SolidPolygonLayer\n(calls getColor) + ScatterplotLayer for cities (calls\nbubbleColor). Sets overlay.setProps({ layers }).\nHover handlers populate hoverInfo state.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
